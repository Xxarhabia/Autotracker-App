<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AutotrackerApp.ViewModels"
             xmlns:local="clr-namespace:AutotrackerApp.Models"
             x:Class="AutotrackerApp.MainPage"
             x:DataType="vm:VehicleListViewModel"
             Title="Vehiculos">

    <Grid RowDefinitions="Auto,*" Padding="20,24" RowSpacing="16">

        <!-- Encabezado con título y botón de registrar, en la misma fila -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Mis Vehiculos" 
                       Style="{StaticResource HeadingLabel}" 
                       VerticalOptions="Center" />
                <Button Grid.Row="1" Text="+ Nuevo" Command="{Binding IrARegistrarCommand}" />
            </Grid>
        
            <SearchBar Grid.Row="1"
                        Placeholder="Buscar por placa..."
                        Text="{Binding SearchText}"
                        SearchCommand="{Binding BuscarCommand}"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CargarVehiculosCommand}">

            <CollectionView ItemsSource="{Binding Vehicles}">

                <!-- Se muestra automáticamente cuando la colección está vacía,
                     en vez de dejar la pantalla en blanco sin explicación -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="🚗" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Aun no tienes vehiculos registrados" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Vehicle">
                        <!-- Tarjeta de vehiculo: placa + marca/modelo y badges de estado -->
                        <Border Background="{StaticResource Surface}"
                                Padding="16"
                                StrokeThickness="0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VehicleListViewModel}}, Path=VerDetalleCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource RadiusCard}" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.08" Radius="12" Offset="0,4" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Plate}" Style="{StaticResource CardTitleLabel}" />
                                    <Ellipse Grid.Column="1"
                                             WidthRequest="14" HeightRequest="14"
                                             Fill="{Binding EngineOn, Converter={StaticResource BoolToStatusColorConverter}}"
                                             VerticalOptions="Center" />
                                </Grid>

                                <Label Text="{Binding Brand}" Style="{StaticResource CaptionLabel}" />

                                <!-- Fila de badges de estado: bloqueado / inmovilizado -->
                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="{StaticResource Background}" Padding="8,4" 
                                            StrokeThickness="0" IsVisible="{Binding Locked}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="🔒 Bloqueado" FontSize="12" TextColor="{StaticResource StatusLocked}" />
                                    </Border>
                                    <Border Background="{StaticResource Background}" Padding="8,4" 
                                            StrokeThickness="0" IsVisible="{Binding Inmovilized}" >
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="⛔ Inmovilizado" FontSize="12" TextColor="{StaticResource StatusDanger}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
    </Grid>

</ContentPage>
