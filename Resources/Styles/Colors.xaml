<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Azul acero: transmite tecnologia/control, apropiado para una app de rastreo -->
    <Color x:Key="Primary">#2A5FD9</Color>
    <Color x:Key="PrimaryDark">#1E48AD</Color>

    <Color x:Key="Background">#F4F6FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="BackgroundDark">#12141C</Color>
    <Color x:Key="SurfaceDark">#1B1E2A</Color>

    <Color x:Key="TextPrimary">#1B1E28</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextPrimaryDark">#F3F4F8</Color>
    <Color x:Key="TextSecondaryDark">#9CA3AF</Color>

    <!-- Colores de estado del vehículo: cada uno con un significado fijo,
         para que el usuario los reconozca de un vistazo en cualquier pantalla -->
    <Color x:Key="StatusOn">#2FA876</Color>
    <Color x:Key="StatusOff">#9CA3AF</Color>
    <Color x:Key="StatusLocked">#2A5FD9</Color>
    <Color x:Key="StatusDanger">#E2574C</Color>

    <Color x:Key="Border">#E4E6F0</Color>
</ResourceDictionary>