<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AutotrackerApp.ViewModels"
             xmlns:local="clr-namespace:AutotrackerApp.Models"
             x:Class="AutotrackerApp.Views.DriversPage"
             x:DataType="vm:DriverListViewModel"
             Title="Conductores">

    <Grid RowDefinitions="Auto,*" Padding="20,24" RowSpacing="16">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Conductores" 
                       Style="{StaticResource HeadingLabel}"
                       VerticalOptions="Center"/>
                <Button Grid.Row="1" Text="+ Nuevo" Command="{Binding IrARegistrarCommand}" />
            </Grid>

            <SearchBar Grid.Row="1"
                       Placeholder="Buscar por documento..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding BuscarCommand}" />
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshEnabled="{Binding IsBusy}"
                     Command="{Binding CargarConductoresCommand}">

            <CollectionView ItemsSource="{Binding Drivers}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="🚘" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Aun no tienes conductores registrados" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Driver">
                        <Border Background="{StaticResource Surface}"
                                Padding="16"
                                StrokeThickness="0">
                            
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource RadiusCard}" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.08" Radius="12" Offset="0,4" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding FullName}" Style="{StaticResource CardTitleLabel}" />
                                <Label Text="{Binding Document}" Style="{StaticResource CaptionLabel}" />

                                <Border BackgroundColor="{StaticResource Background}" Padding="8,4"
                                        StrokeThickness="0" HorizontalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label FontSize="12">
                                        <Label.Text>
                                            <Binding Path="VehiclePlate" TargetNullValue="Sin vehículo asignado" />
                                        </Label.Text>                                        
                                    </Label>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
    </Grid>
    
</ContentPage>